# cyclox2_docker 環境変数サンプル
# このファイルをコピーして .env を作成し、実際の値を設定してください。
#   cp .env.example .env
# .env は .gitignore 済み（コミットしないこと）。

# MySQL root パスワード（cyclox2_mysql / phpMyAdmin / Result System が使用）
MYSQL_ROOT_PASSWORD=<DB_PASSWORD>

# Result System (cyclox2ressys_svr) の DB 接続ユーザー
RESSYS_DB_USERNAME=<DB_USER>
RESSYS_DB_PASSWORD=<DB_PASSWORD>
